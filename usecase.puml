@startuml usecase
left to right direction
skinparam packageStyle rectangle

actor "Администратор" as admin
actor "Преподаватель" as teacher
actor "Студент" as student

rectangle "Система учёта посещаемости студентов" {
  usecase "Войти в систему" as UC1
  usecase "Управлять расписанием занятий" as UC2
  usecase "Добавить / изменить занятие\nв расписании" as UC2a
  usecase "Управлять учётными записями\nпользователей" as UC3
  usecase "Создать / заблокировать\nучётную запись" as UC3a
  usecase "Отметить посещаемость" as UC4
  usecase "Просмотреть журнал\nпосещаемости группы" as UC5
  usecase "Сформировать отчёт\n(CSV / JSON)" as UC6
  usecase "Просмотреть свою\nпосещаемость" as UC7
  usecase "Подать заявку на\nуважительную причину" as UC8
}

admin --> UC1
admin --> UC2
admin --> UC3

teacher --> UC1
teacher --> UC4
teacher --> UC5
teacher --> UC6

student --> UC1
student --> UC7
student --> UC8

UC2 ..> UC2a : <<include>>
UC3 ..> UC3a : <<include>>

@enduml
